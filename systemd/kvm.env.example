# 2026-10-09 22:32 KST: CodexCode - editable LAN console and optional capture settings.
KVM_HOST=0.0.0.0
KVM_PORT=8080
KVM_TOKEN_FILE=/etc/zero2w-kvm/access.token
# Set a real V4L2 capture device; Pi codec nodes such as video10 are not HDMI capture.
KVM_VIDEO_DEVICE=
KVM_VIDEO_SIZE=640x480
KVM_VIDEO_FPS=10
# 2026-10-09 23:35 KST: CodexCode - authenticated Pi browser desktop backend.
KVM_PI_VNC_PORT=6081
KVM_PI_VNC_CREDENTIALS=/etc/zero2w-kvm/pi-vnc.json
KVM_NOVNC_ROOT=/usr/share/novnc
